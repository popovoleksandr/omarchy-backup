# Maintainer: Oleksandr Popov <anantaramdas@outlook.com>
pkgname=omarchy-backup
pkgver=1.1.1
pkgrel=1
pkgdesc="Back up your Omarchy setup (configs, customizations, packages, services) to one file and restore it on a fresh install"
arch=(any)
url="https://github.com/popovoleksandr/omarchy-backup"
license=(MIT)
depends=(bash coreutils curl diffutils findutils git gum jq pacman systemd tar zstd)
optdepends=('yay: restore AUR packages'
            'flatpak: back up and restore Flatpak apps')
install=omarchy-backup.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6a12fc70f9a8dc276bc3eb5330e9cc85934f363da430e9fbb551440dbf0c1ac6')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
